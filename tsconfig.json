{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
, "app/cart/page.jsx", "app/product/[id]/page.jsx", "app/orders/page.jsx", "app/login/page.jsx", "app/register/page.jsx", "app/page.jsx", "app/layout.jsx", "app/wishlist/page.jsx", "lib/utils.js", "lib/store.js", "lib/auth.js", "hooks/use-toast.js", "hooks/use-mobile.js"  ],
  "exclude": [
    "node_modules"
  ]
}
